  - key: prizes.showBigPrizeText
    displayName: "\u041F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C \u0441\u0443\u043F\u0435\u0440\u043F\u0440\u0438\u0437"
    description: "\u041F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C \u0442\u0435\u043A\u0441\u0442
      \u0441\u0443\u043F\u0435\u0440\u043F\u0440\u0438\u0437\u0430. \u0412 \u0442\u0435\u043A\u0441\u0442
      \u0441\u0443\u043F\u0435\u0440\u043F\u0440\u0438\u0437\u0430 \u0437\u0430\u043D\u043E\u0441\u044F\u0442\u0441\u044F
      \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F \u043F\u0440\u0438\u0437\u043E\u0432
      \u0438\u0437 QR-\u043A\u043E\u0434\u043E\u0432 \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435:\\n\\t\u0417\u043E\u043B\u043E\u0442\u043E\u0439
      \u2192 \u0421\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u0439 \u2192
      \u0411\u0440\u043E\u043D\u0437\u043E\u0432\u044B\u0439\\n\u0422\u043E \u0435\u0441\u0442\u044C,
      \u0435\u0441\u043B\u0438 \u043D\u0435 \u0437\u0430\u043F\u043E\u043B\u043D\u0435\u043D
      \u043F\u0440\u0438\u0437 \u0437\u0430 \u0417\u043E\u043B\u043E\u0442\u043E\u0439
      QR, \u0442\u043E \u0431\u0435\u0440\u0435\u0442\u0441\u044F \u043F\u0440\u0438\u0437
      \u0437\u0430 \u0421\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u0439 QR
      \u0438 \u0442.\u0434."
    group: "\u041F\u0440\u0438\u0437\u044B \u0438 \u0432\u044B\u0434\u0430\u0447\u0430"
