  - key: payment.paymentImpulseCost
    displayName: "\u0421\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C \u0438\u043C\u043F\u0443\u043B\u044C\u0441\u0430
      \u043E\u043F\u043B\u0430\u0442\u044B"
    description: "\u0423\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C \u0438\u043C\u043F\u0443\u043B\u044C\u0441\u0430
      \u043E\u043F\u043B\u0430\u0442\u044B \u0441 \u043F\u043B\u0430\u0442\u0435\u0436\u043D\u044B\u0445
      \u0441\u0438\u0441\u0442\u0435\u043C (\u043C\u043E\u043D\u0435\u0442\u043E\u043F\u0440\u0438\u0435\u043C\u043D\u0438\u043A\u0438,
      \u043A\u0443\u043F\u044E\u0440\u043E\u043F\u0440\u0438\u0435\u043C\u043D\u0438\u043A\u0438,
      \u0442\u0435\u0440\u043C\u0438\u043D\u0430\u043B\u044B \u043E\u043F\u043B\u0430\u0442\u044B,
      \u0436\u0435\u0442\u043E\u043D\u043E\u043F\u0440\u0438\u0435\u043C\u043D\u0438\u043A\u0438).
      \u0415\u0441\u043B\u0438 \u0432\u043A\u043B\u044E\u0447\u0435\u043D\u0430 \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u0430\u044F
      \u0438\u0433\u0440\u0430, \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435
      \u043C\u0435\u043D\u044F\u0435\u0442"
    group: "\u041E\u043F\u043B\u0430\u0442\u0430 \u0438 \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C"
