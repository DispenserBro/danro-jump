    <ui:VisualElement name="ModalLayer" class="modal-layer" style="opacity: 1; display: flex;">
        <ui:VisualElement name="ModalBackdrop" class="modal-backdrop"/>
        <ui:VisualElement name="RulesModal" class="modal-window rules-modal fullscreen-modal" style="display: flex; justify-content: space-between;">
